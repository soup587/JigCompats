{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/basefiguraaddon/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "soup587.fabric.BaseFiguraAddonFabric"
    ],
    "client": [
      "soup587.fabric.client.BaseFiguraAddonFabricClient"
    ]
  },
  "mixins": [
    "basefiguraaddon.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "figura": ">=${figura_version}"
  }
}
